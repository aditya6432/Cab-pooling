digraph PoolUp {
  graph [rankdir=LR, splines=spline, nodesep=0.28, ranksep=0.75, fontname="DejaVu Sans", bgcolor="white", pad=0.25];
  node  [shape=plain, fontname="DejaVu Sans", fontsize=9];
  edge  [fontname="DejaVu Sans", fontsize=8, color="#4b5563", fontcolor="#374151", arrowsize=0.75, penwidth=1.1, dir=both];
  subgraph cluster_M1 { label=<<b>Member 1 · Users + ride creation / search</b>>; fontsize=11; fontcolor="#2a78d6"; color="#2a78d6"; style="rounded,dashed"; margin=10;
  HOSTEL [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2a78d6" bgcolor="white"><tr><td colspan="2" bgcolor="#2a78d6" align="left"><font color="white"><b>HOSTEL</b></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>PK</b></font></td><td align="left">hostel_id</td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>UQ</b></font></td><td align="left">name</td></tr></table>>];
  STUDENT [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2a78d6" bgcolor="white"><tr><td colspan="2" bgcolor="#2a78d6" align="left"><font color="white"><b>STUDENT</b></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>PK</b></font></td><td align="left">student_id  (BITS ID pattern)</td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>UQ</b></font></td><td align="left">email  (@hyderabad.bits-pilani.ac.in)</td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>UQ</b></font></td><td align="left">phone  (10 digits)</td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>FK</b></font></td><td align="left">hostel_id</td></tr><tr><td align="left" width="38"> </td><td align="left">full_name, password_hash, created_at</td></tr></table>>];
  AUTH_SESSION [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2a78d6" bgcolor="white"><tr><td colspan="2" bgcolor="#2a78d6" align="left"><font color="white"><b>AUTH_SESSION</b></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>PK</b></font></td><td align="left">token_hash  (SHA-256)</td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>FK</b></font></td><td align="left">student_id</td></tr><tr><td align="left" width="38"> </td><td align="left">created_at, expires_at</td></tr></table>>];
  LOCATION [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2a78d6" bgcolor="white"><tr><td colspan="2" bgcolor="#2a78d6" align="left"><font color="white"><b>LOCATION</b></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>PK</b></font></td><td align="left">location_id</td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>UQ</b></font></td><td align="left">name</td></tr><tr><td align="left" width="38"> </td><td align="left">loc_type, latitude, longitude</td></tr></table>>];
  CAB_TYPE [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2a78d6" bgcolor="white"><tr><td colspan="2" bgcolor="#2a78d6" align="left"><font color="white"><b>CAB_TYPE</b></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>PK</b></font></td><td align="left">cab_type</td></tr><tr><td align="left" width="38"> </td><td align="left">max_seats, base_fare, per_km</td></tr></table>>];
  RIDE [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2a78d6" bgcolor="white"><tr><td colspan="2" bgcolor="#2a78d6" align="left"><font color="white"><b>RIDE</b></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>PK</b></font></td><td align="left">ride_id</td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>FK</b></font></td><td align="left">creator_id → STUDENT</td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>FK</b></font></td><td align="left">origin_id, dest_id → LOCATION</td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>FK</b></font></td><td align="left">cab_type</td></tr><tr><td align="left" width="38"> </td><td align="left">depart_start, depart_end  (≤ 3 h)</td></tr><tr><td align="left" width="38"> </td><td align="left">distance_km, note</td></tr><tr><td align="left" width="38"> </td><td align="left">status, completed_at</td></tr></table>>];
  RIDE_STOP [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2a78d6" bgcolor="white"><tr><td colspan="2" bgcolor="#2a78d6" align="left"><font color="white"><b>RIDE_STOP</b>  <font point-size="8">(weak)</font></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>PK,FK</b></font></td><td align="left">ride_id</td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>PK</b></font></td><td align="left">stop_seq  (1..3)</td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>FK</b></font></td><td align="left">location_id</td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>UQ</b></font></td><td align="left">(ride_id, location_id)</td></tr></table>>];
  RIDE_STATUS_LOG [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#2a78d6" bgcolor="white"><tr><td colspan="2" bgcolor="#2a78d6" align="left"><font color="white"><b>RIDE_STATUS_LOG</b>  <font point-size="8">(history)</font></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>PK</b></font></td><td align="left">log_id</td></tr><tr><td align="left" width="38"><font point-size="8" color="#2a78d6"><b>FK</b></font></td><td align="left">ride_id</td></tr><tr><td align="left" width="38"> </td><td align="left">old_status, new_status, changed_at</td></tr></table>>];
  }
  subgraph cluster_M2 { label=<<b>Member 2 · Booking + ride pooling / seats</b>>; fontsize=11; fontcolor="#b45309"; color="#b45309"; style="rounded,dashed"; margin=10;
  RIDE_MEMBER [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#b45309" bgcolor="white"><tr><td colspan="2" bgcolor="#b45309" align="left"><font color="white"><b>RIDE_MEMBER</b>  <font point-size="8">(seat booking · hub of the schema)</font></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#b45309"><b>PK,FK</b></font></td><td align="left">ride_id</td></tr><tr><td align="left" width="38"><font point-size="8" color="#b45309"><b>PK,FK</b></font></td><td align="left">student_id</td></tr><tr><td align="left" width="38"> </td><td align="left">seats_taken  (1..6)</td></tr><tr><td align="left" width="38"> </td><td align="left">status: confirmed | cancelled | no_show</td></tr><tr><td align="left" width="38"><font point-size="8" color="#b45309"><b>FK</b></font></td><td align="left">pickup_id, dropoff_id → LOCATION</td></tr><tr><td align="left" width="38"> </td><td align="left">joined_at, cancelled_at, cancel_reason</td></tr></table>>];
  RIDE_BOOKING_POLICY [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#b45309" bgcolor="white"><tr><td colspan="2" bgcolor="#b45309" align="left"><font color="white"><b>RIDE_BOOKING_POLICY</b></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#b45309"><b>PK,FK</b></font></td><td align="left">ride_id  (1 : 0..1)</td></tr><tr><td align="left" width="38"> </td><td align="left">join_mode: instant | approval</td></tr></table>>];
  BOOKING_REQUEST [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#b45309" bgcolor="white"><tr><td colspan="2" bgcolor="#b45309" align="left"><font color="white"><b>BOOKING_REQUEST</b></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#b45309"><b>PK</b></font></td><td align="left">request_id</td></tr><tr><td align="left" width="38"><font point-size="8" color="#b45309"><b>FK</b></font></td><td align="left">ride_id, student_id</td></tr><tr><td align="left" width="38"><font point-size="8" color="#b45309"><b>FK</b></font></td><td align="left">pickup_id, dropoff_id</td></tr><tr><td align="left" width="38"> </td><td align="left">seats, message, status</td></tr><tr><td align="left" width="38"><font point-size="8" color="#b45309"><b>UQ</b></font></td><td align="left">(ride_id, student_id) WHERE pending</td></tr></table>>];
  RIDE_WAITLIST [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#b45309" bgcolor="white"><tr><td colspan="2" bgcolor="#b45309" align="left"><font color="white"><b>RIDE_WAITLIST</b></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#b45309"><b>PK,FK</b></font></td><td align="left">ride_id</td></tr><tr><td align="left" width="38"><font point-size="8" color="#b45309"><b>PK,FK</b></font></td><td align="left">student_id</td></tr><tr><td align="left" width="38"> </td><td align="left">seats, joined_at  (FIFO order)</td></tr></table>>];
  BOOKING_EVENT [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#b45309" bgcolor="white"><tr><td colspan="2" bgcolor="#b45309" align="left"><font color="white"><b>BOOKING_EVENT</b>  <font point-size="8">(history)</font></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#b45309"><b>PK</b></font></td><td align="left">event_id</td></tr><tr><td align="left" width="38"><font point-size="8" color="#b45309"><b>FK</b></font></td><td align="left">ride_id, student_id</td></tr><tr><td align="left" width="38"> </td><td align="left">event (13 kinds), seats, created_at</td></tr></table>>];
  }
  subgraph cluster_M3 { label=<<b>Member 3 · Expense splitting</b>>; fontsize=11; fontcolor="#0f766e"; color="#0f766e"; style="rounded,dashed"; margin=10;
  EXPENSE [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#0f766e" bgcolor="white"><tr><td colspan="2" bgcolor="#0f766e" align="left"><font color="white"><b>EXPENSE</b></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#0f766e"><b>PK</b></font></td><td align="left">expense_id</td></tr><tr><td align="left" width="38"><font point-size="8" color="#0f766e"><b>FK</b></font></td><td align="left">(ride_id, paid_by) → RIDE_MEMBER</td></tr><tr><td align="left" width="38"> </td><td align="left">amount  (0 &lt; a ≤ 50 000)</td></tr><tr><td align="left" width="38"> </td><td align="left">note, split_type, created_at</td></tr></table>>];
  EXPENSE_SHARE [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#0f766e" bgcolor="white"><tr><td colspan="2" bgcolor="#0f766e" align="left"><font color="white"><b>EXPENSE_SHARE</b>  <font point-size="8">(weak)</font></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#0f766e"><b>PK,FK</b></font></td><td align="left">expense_id</td></tr><tr><td align="left" width="38"><font point-size="8" color="#0f766e"><b>PK,FK</b></font></td><td align="left">student_id</td></tr><tr><td align="left" width="38"> </td><td align="left">share_amount  (Σ = amount, deferred)</td></tr></table>>];
  EXPENSE_AUDIT [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#0f766e" bgcolor="white"><tr><td colspan="2" bgcolor="#0f766e" align="left"><font color="white"><b>EXPENSE_AUDIT</b>  <font point-size="8">(history)</font></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#0f766e"><b>PK</b></font></td><td align="left">audit_id</td></tr><tr><td align="left" width="38"> </td><td align="left">expense_id, ride_id  (no FK: outlives deletes)</td></tr><tr><td align="left" width="38"> </td><td align="left">action, actor_id, amount</td></tr></table>>];
  }
  subgraph cluster_M4 { label=<<b>Member 4 · Payments + settlement</b>>; fontsize=11; fontcolor="#6d28d9"; color="#6d28d9"; style="rounded,dashed"; margin=10;
  PAYMENT_METHOD [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#6d28d9" bgcolor="white"><tr><td colspan="2" bgcolor="#6d28d9" align="left"><font color="white"><b>PAYMENT_METHOD</b></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#6d28d9"><b>PK</b></font></td><td align="left">method_id</td></tr><tr><td align="left" width="38"><font point-size="8" color="#6d28d9"><b>FK</b></font></td><td align="left">student_id</td></tr><tr><td align="left" width="38"><font point-size="8" color="#6d28d9"><b>UQ</b></font></td><td align="left">vpa  (name@bank)</td></tr><tr><td align="left" width="38"><font point-size="8" color="#6d28d9"><b>UQ</b></font></td><td align="left">is_default: one per student (partial)</td></tr></table>>];
  PAYMENT_TRANSITION [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#6d28d9" bgcolor="white"><tr><td colspan="2" bgcolor="#6d28d9" align="left"><font color="white"><b>PAYMENT_TRANSITION</b>  <font point-size="8">(state machine as data)</font></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#6d28d9"><b>PK</b></font></td><td align="left">(from_status, to_status, actor_role)</td></tr><tr><td align="left" width="38"> </td><td align="left">meaning</td></tr></table>>];
  PAYMENT [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#6d28d9" bgcolor="white"><tr><td colspan="2" bgcolor="#6d28d9" align="left"><font color="white"><b>PAYMENT</b></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#6d28d9"><b>PK</b></font></td><td align="left">payment_id</td></tr><tr><td align="left" width="38"><font point-size="8" color="#6d28d9"><b>UQ</b></font></td><td align="left">client_ref  (idempotency key)</td></tr><tr><td align="left" width="38"><font point-size="8" color="#6d28d9"><b>UQ</b></font></td><td align="left">utr  (12 digits, UPI only)</td></tr><tr><td align="left" width="38"><font point-size="8" color="#6d28d9"><b>FK</b></font></td><td align="left">(ride_id, payer_id) → RIDE_MEMBER</td></tr><tr><td align="left" width="38"><font point-size="8" color="#6d28d9"><b>FK</b></font></td><td align="left">(ride_id, payee_id) → RIDE_MEMBER</td></tr><tr><td align="left" width="38"> </td><td align="left">amount, method: upi | cash | offset</td></tr><tr><td align="left" width="38"> </td><td align="left">status, offset_group, confirmed_at</td></tr></table>>];
  PAYMENT_EVENT [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#6d28d9" bgcolor="white"><tr><td colspan="2" bgcolor="#6d28d9" align="left"><font color="white"><b>PAYMENT_EVENT</b>  <font point-size="8">(history)</font></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#6d28d9"><b>PK</b></font></td><td align="left">event_id</td></tr><tr><td align="left" width="38"><font point-size="8" color="#6d28d9"><b>FK</b></font></td><td align="left">payment_id</td></tr><tr><td align="left" width="38"><font point-size="8" color="#6d28d9"><b>FK</b></font></td><td align="left">actor_id</td></tr><tr><td align="left" width="38"> </td><td align="left">from_status, to_status, actor_role</td></tr></table>>];
  PAYMENT_REMINDER [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#6d28d9" bgcolor="white"><tr><td colspan="2" bgcolor="#6d28d9" align="left"><font color="white"><b>PAYMENT_REMINDER</b></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#6d28d9"><b>PK</b></font></td><td align="left">reminder_id</td></tr><tr><td align="left" width="38"><font point-size="8" color="#6d28d9"><b>FK</b></font></td><td align="left">(ride_id, creditor_id) → RIDE_MEMBER</td></tr><tr><td align="left" width="38"><font point-size="8" color="#6d28d9"><b>FK</b></font></td><td align="left">(ride_id, debtor_id) → RIDE_MEMBER</td></tr><tr><td align="left" width="38"><font point-size="8" color="#6d28d9"><b>EX</b></font></td><td align="left">no overlapping 24 h windows (GiST)</td></tr><tr><td align="left" width="38"> </td><td align="left">amount_due, message, sent_at</td></tr></table>>];
  }
  subgraph cluster_M5 { label=<<b>Member 5 · Ratings + analytics</b>>; fontsize=11; fontcolor="#be123c"; color="#be123c"; style="rounded,dashed"; margin=10;
  RATING [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#be123c" bgcolor="white"><tr><td colspan="2" bgcolor="#be123c" align="left"><font color="white"><b>RATING</b></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#be123c"><b>PK</b></font></td><td align="left">(ride_id, rater_id, ratee_id)</td></tr><tr><td align="left" width="38"><font point-size="8" color="#be123c"><b>FK</b></font></td><td align="left">(ride_id, rater_id) → RIDE_MEMBER</td></tr><tr><td align="left" width="38"><font point-size="8" color="#be123c"><b>FK</b></font></td><td align="left">(ride_id, ratee_id) → RIDE_MEMBER</td></tr><tr><td align="left" width="38"> </td><td align="left">score  (1..5), comment</td></tr><tr><td align="left" width="38"> </td><td align="left">created_at, updated_at</td></tr></table>>];
  RATING_TAG [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#be123c" bgcolor="white"><tr><td colspan="2" bgcolor="#be123c" align="left"><font color="white"><b>RATING_TAG</b></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#be123c"><b>PK</b></font></td><td align="left">tag_id</td></tr><tr><td align="left" width="38"><font point-size="8" color="#be123c"><b>UQ</b></font></td><td align="left">label</td></tr><tr><td align="left" width="38"> </td><td align="left">sentiment</td></tr></table>>];
  RATING_TAG_MAP [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#be123c" bgcolor="white"><tr><td colspan="2" bgcolor="#be123c" align="left"><font color="white"><b>RATING_TAG_MAP</b></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#be123c"><b>PK,FK</b></font></td><td align="left">(ride_id, rater_id, ratee_id)</td></tr><tr><td align="left" width="38"><font point-size="8" color="#be123c"><b>PK,FK</b></font></td><td align="left">tag_id</td></tr></table>>];
  RATING_AUDIT [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#be123c" bgcolor="white"><tr><td colspan="2" bgcolor="#be123c" align="left"><font color="white"><b>RATING_AUDIT</b>  <font point-size="8">(history)</font></font></td></tr><tr><td align="left" width="38"><font point-size="8" color="#be123c"><b>PK</b></font></td><td align="left">audit_id</td></tr><tr><td align="left" width="38"> </td><td align="left">ride_id, rater_id, ratee_id</td></tr><tr><td align="left" width="38"> </td><td align="left">action, old/new score, changed_at</td></tr></table>>];
  }
  HOSTEL -> STUDENT [arrowtail=tee, arrowhead=crowodot, label=" lives in "];
  STUDENT -> AUTH_SESSION [arrowtail=tee, arrowhead=crowodot];
  STUDENT -> RIDE [arrowtail=tee, arrowhead=crowodot, label=" creates "];
  LOCATION -> RIDE [arrowtail=tee, arrowhead=crowodot, label=" origin / destination "];
  CAB_TYPE -> RIDE [arrowtail=tee, arrowhead=crowodot];
  RIDE -> RIDE_STOP [arrowtail=tee, arrowhead=crowodot, label=" stops (≤ 3) ", style=bold];
  LOCATION -> RIDE_STOP [arrowtail=tee, arrowhead=crowodot];
  RIDE -> RIDE_STATUS_LOG [arrowtail=tee, arrowhead=crowodot, style=dashed];
  RIDE -> RIDE_MEMBER [arrowtail=tee, arrowhead=crow, label=" has seats "];
  STUDENT -> RIDE_MEMBER [arrowtail=tee, arrowhead=crowodot, label=" books "];
  RIDE -> RIDE_BOOKING_POLICY [arrowtail=tee, arrowhead=teeodot];
  RIDE -> BOOKING_REQUEST [arrowtail=tee, arrowhead=crowodot];
  STUDENT -> BOOKING_REQUEST [arrowtail=tee, arrowhead=crowodot];
  RIDE -> RIDE_WAITLIST [arrowtail=tee, arrowhead=crowodot];
  STUDENT -> RIDE_WAITLIST [arrowtail=tee, arrowhead=crowodot];
  RIDE -> BOOKING_EVENT [arrowtail=tee, arrowhead=crowodot, style=dashed];
  RIDE_MEMBER -> EXPENSE [arrowtail=tee, arrowhead=crowodot, label=" pays "];
  EXPENSE -> EXPENSE_SHARE [arrowtail=tee, arrowhead=crow, label=" split into ", style=bold];
  STUDENT -> EXPENSE_SHARE [arrowtail=tee, arrowhead=crowodot];
  EXPENSE -> EXPENSE_AUDIT [arrowtail=tee, arrowhead=crowodot, style=dotted];
  STUDENT -> PAYMENT_METHOD [arrowtail=tee, arrowhead=crowodot];
  RIDE_MEMBER -> PAYMENT [arrowtail=tee, arrowhead=crowodot, label=" pays / is paid "];
  PAYMENT -> PAYMENT_EVENT [arrowtail=tee, arrowhead=crow, style=dashed];
  PAYMENT_TRANSITION -> PAYMENT_EVENT [arrowtail=tee, arrowhead=crowodot, label=" allowed moves ", style=dotted];
  RIDE_MEMBER -> PAYMENT_REMINDER [arrowtail=tee, arrowhead=crowodot, label=" reminds "];
  RIDE_MEMBER -> RATING [arrowtail=tee, arrowhead=crowodot, label=" rates / is rated "];
  RATING -> RATING_TAG_MAP [arrowtail=tee, arrowhead=crowodot, label=" ≤ 3 tags "];
  RATING_TAG -> RATING_TAG_MAP [arrowtail=tee, arrowhead=crowodot];
  RATING -> RATING_AUDIT [arrowtail=tee, arrowhead=crow, style=dotted];
}